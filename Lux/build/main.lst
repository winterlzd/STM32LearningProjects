  57:Core/Src/main.c **** uint16_t Read_Light(void){
  58:Core/Src/main.c ****   /* 16 次采样取平均，消除噪声、显示更稳定 */
  59:Core/Src/main.c ****   uint32_t sum = 0;
  60:Core/Src/main.c ****   for (uint8_t i = 0; i < 16; i++) {
  61:Core/Src/main.c ****     HAL_ADC_Start(&hadc1);
  62:Core/Src/main.c ****     HAL_ADC_PollForConversion(&hadc1, 10);
  63:Core/Src/main.c ****     sum += HAL_ADC_GetValue(&hadc1);
  64:Core/Src/main.c ****   }
  65:Core/Src/main.c ****   return (uint16_t)(sum >> 4);   // 等效除以 16，返回 0~4095
  66:Core/Src/main.c **** }
  67:Core/Src/main.c **** /* USER CODE END PFP */
