  91:Core/Src/main.c ****   HAL_Delay(2000);  // 停 2 秒观察
  92:Core/Src/main.c **** 
  93:Core/Src/main.c ****   /* 4. 测试：在第 5 行点亮最右边 3 个点 */
  94:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET);
  95:Core/Src/main.c ****   uint8_t pattern[2] = { 5, 0x07 };  // 二进制 0000 0111
  96:Core/Src/main.c ****   HAL_SPI_Transmit(&hspi1, pattern, 2, 100);
  97:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);
