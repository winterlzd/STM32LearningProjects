  74:Core/Src/main.c **** /* SPI 自检 */
  75:Core/Src/main.c **** static void max7219_selftest(void)
  76:Core/Src/main.c **** {
  77:Core/Src/main.c ****   /* 1. 关闭所有段（把 8 行都置 0） */
  78:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET);  // CS 低
  79:Core/Src/main.c ****   for (uint8_t i = 1; i <= 8; i++) {
  80:Core/Src/main.c ****     uint8_t cmd[2] = { i, 0x00 };
  81:Core/Src/main.c ****     HAL_SPI_Transmit(&hspi1, cmd, 2, 100);
  82:Core/Src/main.c ****   }
  83:Core/Src/main.c ****   /* 2. 关掉显示测试模式（保险起见再写一次） */
  84:Core/Src/main.c ****   uint8_t test_off[2] = { 0x0F, 0x00 };
  85:Core/Src/main.c ****   HAL_SPI_Transmit(&hspi1, test_off, 2, 100);
  86:Core/Src/main.c ****   /* 3. 退出 shutdown */
  87:Core/Src/main.c ****   uint8_t normal[2] = { 0x0C, 0x01 };
  88:Core/Src/main.c ****   HAL_SPI_Transmit(&hspi1, normal, 2, 100);
  89:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);    // CS 高
  90:Core/Src/main.c **** 
