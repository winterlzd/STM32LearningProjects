  99:Core/Src/main.c ****   /* 
 100:Core/Src/main.c ****    * 重要：OLED 使用 GPIO 模拟 I2C，必须在 HAL 硬件 I2C 初始化之前调用！
 101:Core/Src/main.c ****    * MX_I2C1_Init / MX_I2C2_Init 会将 PB6/PB7/PB10/PB11 配置为 AF_OD 模式，
 102:Core/Src/main.c ****    * 与 OLED 驱动的推挽 GPIO 模拟 I2C 产生严重冲突，导致花屏和黑屏。
 103:Core/Src/main.c ****    * 如果你不需要硬件 I2C 做其他事情，可以完全去掉 MX_I2C1_Init / MX_I2C2_Init�
 104:Core/Src/main.c ****    */
 105:Core/Src/main.c ****   OLED_Init();
 106:Core/Src/main.c ****   OLED_ShowString(1, 1, "Light Val:");
 107:Core/Src/main.c ****   /* USER CODE END 2 */
 108:Core/Src/main.c **** 
 109:Core/Src/main.c ****   /* Infinite loop */
 110:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 111:Core/Src/main.c ****   while (1)
 112:Core/Src/main.c ****   {
 113:Core/Src/main.c ****     /* USER CODE END WHILE */
 114:Core/Src/main.c ****     uint32_t light_value = 0;
 115:Core/Src/main.c ****     HAL_ADC_Start(&hadc1);
 116:Core/Src/main.c ****     if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK){
 117:Core/Src/main.c ****       light_value = HAL_ADC_GetValue(&hadc1);
 118:Core/Src/main.c ****     }
 119:Core/Src/main.c ****     HAL_ADC_Stop(&hadc1);
 120:Core/Src/main.c ****     
 121:Core/Src/main.c ****     OLED_ShowNum(2, 1, light_value, 4);
 122:Core/Src/main.c ****     HAL_Delay(200);
 123:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 124:Core/Src/main.c ****   }
 125:Core/Src/main.c ****   /* USER CODE END 3 */
 126:Core/Src/main.c **** }
